[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://game/systems/psychokinesis/psychokinetic_body_2d.gd" id="1_body"]
[ext_resource type="Script" path="res://game/systems/persistence/persistent_world_instance.gd" id="2_persistence"]
[ext_resource type="Script" path="res://game/systems/psychokinesis/psychokinesis_state_machine.gd" id="3_state"]
[ext_resource type="Script" path="res://game/systems/psychokinesis/psychokinesis_interaction_area_2d.gd" id="4_interaction"]
[ext_resource type="Script" path="res://game/systems/psychokinesis/psychokinesis_presentation_2d.gd" id="5_presentation"]

[sub_resource type="CapsuleShape2D" id="Capsule_default"]
resource_local_to_scene = true
radius = 5.0
height = 14.0

[sub_resource type="RectangleShape2D" id="Rectangle_selection"]
resource_local_to_scene = true
size = Vector2(32, 32)

[node name="PsychokineticProp" type="RigidBody2D"]
collision_layer = 4
collision_mask = 1
mass = 0.4
gravity_scale = 0.0
freeze = true
script = ExtResource("1_body")
editor_description = "OBJET PSYCHOKINÉTIQUE GÉNÉRIQUE\n\nScène Godot canonique instanciée par le convertisseur Tiled. Modifie ici la structure et le comportement communs à tous les petits objets manipulables. Les valeurs propres à chaque placement (sprite, masse, collision, ancre et identifiant) sont appliquées lors de la conversion. Au repos, le corps est figé pour préserver exactement la position auteur ; une prise ou une projection réveille sa physique."

[node name="Persistence" type="Node" parent="."]
script = ExtResource("2_persistence")
editor_description = "Mémorise la position et la rotation de cette instance entre deux chargements de carte. L'identifiant unique vient du placement Tiled."

[node name="Visual" type="TileMapLayer" parent="."]
collision_enabled = false
editor_description = "RENDU PRINCIPAL\n\nAffiche la tuile d'atlas choisie dans Tiled. Ce calque n'a aucune autorité physique : sa collision de TileSet reste désactivée."

[node name="SelectionGhost" type="TileMapLayer" parent="."]
visible = false
collision_enabled = false
editor_description = "SURBRILLANCE PSYCHOKINÉTIQUE\n\nCopie exacte du rendu principal. Le script lui applique le shader cyan au survol et violet pendant la prise. Ne pas la positionner séparément."

[node name="SelectionArea" type="Area2D" parent="."]
collision_layer = 128
collision_mask = 0
input_pickable = true
monitoring = false
script = ExtResource("4_interaction")
editor_description = "ZONE DE SURVOL\n\nZone Godot dédiée à la souris, indépendante de la petite collision physique située aux pieds. Le convertisseur l'ajuste aux dimensions réelles du contenu visible."

[node name="HoverShape" type="CollisionShape2D" parent="SelectionArea"]
shape = SubResource("Rectangle_selection")
editor_description = "Forme canonique de survol calculée depuis la bounding box du contenu détouré. Elle est l'unique autorité de sélection, indépendamment du type de rendu."

[node name="PhysicsFootprint" type="CollisionShape2D" parent="."]
shape = SubResource("Capsule_default")
editor_description = "EMPREINTE PHYSIQUE\n\nCollision au niveau du sol, calculée d'après le rôle et la masse de l'objet. Elle ne sert pas à la sélection à la souris, qui suit les pixels opaques du visuel."

[node name="Shadow" type="Polygon2D" parent="."]
z_index = -1
polygon = PackedVector2Array(-6.72, -1.8, 6.72, -1.8, 8.12, 1.2, 5.32, 2.8, -5.32, 2.8, -8.12, 1.2)
color = Color(0.05, 0.06, 0.07, 0.26)
editor_description = "OMBRE AU SOL\n\nReste attachée au sol quand l'objet monte, flotte, tourne ou est projeté. Sa taille est reconstruite depuis l'empreinte physique."

[node name="StateMachine" type="Node" parent="."]
script = ExtResource("3_state")
editor_description = "ÉTATS PSYCHOKINÉTIQUES\n\nAutorité unique des transitions idle, targeted, held, charging, thrown et landing."

[node name="Presentation" type="Node2D" parent="."]
script = ExtResource("5_presentation")
editor_description = "PRÉSENTATION PSYCHOKINÉTIQUE\n\nGère exclusivement halo, élévation visuelle, ombre au sol, sons et particules."
